# Ensure shell scripts use LF line endings (prevents CRLF issues on Linux CI)
gradlew text eol=lf
*.sh text eol=lf
gradlew.bat text eol=crlf

# Ensure Java/Kotlin/Gradle files use LF
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.properties text eol=lf

# Ensure web/config files use LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.jar binary
*.so binary
*.dex binary
*.apk binary
*.aab binary
